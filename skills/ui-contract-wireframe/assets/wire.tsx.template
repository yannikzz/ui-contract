/**
 * Wireframe display layer. Starting point for <wireframe>/src/wire.tsx.
 *
 * Throwaway: when the structure changes, regenerate it. This file holds the neutral
 * parts and the one place colour values are allowed to exist.
 *
 * The rule that keeps it from becoming a second value authority is not "no
 * colour here" — it is **no colour VALUES here**:
 *
 *   - every colour goes through a --wire-* custom property
 *   - the only values are in NEUTRAL below, and they are this wireframe's own greys
 *   - preview mode overrides those same properties by READING the token file at
 *     runtime; it copies nothing, so it cannot go stale
 *   - it does not persist, so every reload is grey again
 *
 * **That rule covers the whole wireframe directory, not just this file.** The single
 * exemption is `inspect.tsx`, which holds the apparatus — annotation layer, skin
 * banner, skin editor, and the browser chrome — and carries fixed colours because none of it
 * may follow the skin. The exemption is a file, so moving something into it shows up
 * as a file move in review. `check-colours.sh` enforces both halves in the generated
 * project; nothing else does.
 */
import { useMemo, useState } from 'react'
import type { CSSProperties, ReactNode } from 'react'

// ── Colour: one place, and it is greys ──────────────────────
/**
 * The wireframe's own neutral palette — **the only colour values outside inspect.tsx**.
 * Every part below reads these through var(). Add a colour value anywhere else in the
 * wireframe and `check-colours.sh` fails, which is the point: an overturned decision
 * needs a mechanical guard, not a note.
 *
 * ⚠ What that guard does NOT catch: adding a brand colour **to this map**. Values are
 * legal in here — they are the wireframe's own greys — so "is the thing you added
 * actually grey" is a review question, and always will be.
 */
export const NEUTRAL: Record<string, string> = {
  '--wire-surface': '#ffffff',
  '--wire-fg': '#404040',
  '--wire-muted': '#f5f5f5',
  '--wire-muted-fg': '#737373',
  '--wire-line': '#d4d4d4',
  '--wire-strong': '#262626',
  '--wire-strong-fg': '#ffffff',
  '--wire-radius': '0.5rem',
}

/**
 * TODO — fill from design.md's declaration table. Left side is fixed (these are
 * the wireframe's roles); right side is this project's token names, the same
 * ones the tuning instrument reads. Ships EMPTY: a filled-in map here would be
 * this file naming the project's tokens, and design.md is the name authority.
 *
 * A role left empty simply stays neutral with the preview on. That is honest —
 * inventing a value to fill the gap is the failure this whole split prevents.
 */
export const SKIN: Record<string, string> = {
  '--wire-surface': '',
  '--wire-fg': '',
  '--wire-muted': '',
  '--wire-muted-fg': '',
  '--wire-line': '',
  '--wire-strong': '',
  '--wire-strong-fg': '',
  '--wire-radius': '',
}


/**
 * `base` is what the token file says right now — read live, never copied.
 * `draft` is what the user has typed in this session, and it dies with the tab:
 * a wireframe that remembers values is a second value authority.
 */
export function useSkin(on: boolean) {
  const [draft, setDraft] = useState<Record<string, string>>({})
  // TODO ids come from `originate` Step 1's candidate directions; the chosen one first.
  const [theme, setTheme] = useState<string>('A')
  const base = useMemo(() => {
    const b: Record<string, string> = { ...NEUTRAL }
    if (!on || typeof window === 'undefined') return b
    // The chosen direction reads the token file live. The declined ones read the
    // candidate sets out of the knobs record — this project's own derivations, never
    // values this file carries.
    const root = getComputedStyle(document.documentElement)
    for (const [role, token] of Object.entries(SKIN)) {
      if (!token) continue
      const v =
        theme === 'A'
          ? root.getPropertyValue(token.startsWith('--') ? token : `--${token}`).trim()
          : candidateValue(theme, token)
      if (v) b[role] = v
    }
    return b
  }, [on, theme])
  const vars = useMemo(
    () => ({ ...base, ...(on ? draft : {}) }) as CSSProperties,
    [base, draft, on],
  )
  return {
    vars,
    base,
    draft,
    theme,
    setTheme,
    set: (role: string, value: string) => setDraft((d) => ({ ...d, [role]: value })),
    reset: () => setDraft({}),
  }
}

/**
 * TODO read the declined directions out of the knobs record and return what this token
 * holds under `theme`. **Do not inline the values here** — a wireframe carrying a second
 * brand's numbers is the second value authority this whole split exists to prevent.
 */
function candidateValue(_theme: string, _token: string): string {
  return ''
}

// ── Neutral wireframe parts ─────────────────────────────────
/** Status label. Expresses only "a status label goes here"; color semantics live in design.md. */
export function Badge({ children }: { children: ReactNode }) {
  return (
    <span className="shrink-0 rounded border border-[var(--wire-line)] px-1 text-[10px] leading-[14px] font-semibold text-[var(--wire-muted-fg)]">
      {children}
    </span>
  )
}

/** Pill: tabs, filter chips, count badges. `on` marks the selected state. */
export function Pill({
  children,
  on = false,
  className = '',
}: {
  children: ReactNode
  on?: boolean
  className?: string
}) {
  return (
    <span
      className={`inline-flex shrink-0 items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs whitespace-nowrap ${
        on
          ? 'border-[var(--wire-strong)] bg-[var(--wire-strong)] font-medium text-[var(--wire-strong-fg)]'
          : 'border-[var(--wire-line)] bg-[var(--wire-surface)] text-[var(--wire-muted-fg)]'
      } ${className}`}
    >
      {children}
    </span>
  )
}

/** Button. `weight` maps to design.md's button hierarchy; the wireframe only varies grey depth. */
export function Btn({
  children,
  weight = 'secondary',
  className = '',
}: {
  children: ReactNode
  weight?: 'primary' | 'secondary' | 'outline' | 'ghost'
  className?: string
}) {
  const style = {
    primary: 'bg-[var(--wire-strong)] text-[var(--wire-strong-fg)] border-[var(--wire-strong)] font-medium',
    secondary: 'bg-[var(--wire-muted)] text-[var(--wire-fg)] border-[var(--wire-line)]',
    outline: 'bg-[var(--wire-surface)] text-[var(--wire-fg)] border-[var(--wire-line)]',
    ghost: 'bg-transparent text-[var(--wire-muted-fg)] border-transparent',
  }[weight]
  return (
    <button className={`rounded-[var(--wire-radius)] border px-3 py-1.5 text-xs ${style} ${className}`}>
      {children}
    </button>
  )
}

/** Content block: white face + hairline. */
export function Card({ children, className = '' }: { children: ReactNode; className?: string }) {
  return (
    <div className={`rounded-[var(--wire-radius)] border border-[var(--wire-line)] bg-[var(--wire-surface)] ${className}`}>{children}</div>
  )
}

/** Avatar / icon placeholder. The wireframe doesn't draw graphics, it reserves space. */
export function Tile({ size = 28, round = false }: { size?: number; round?: boolean }) {
  return (
    <span
      className={`shrink-0 bg-[var(--wire-muted)] ${round ? 'rounded-full' : 'rounded-md'}`}
      style={{ width: size, height: size }}
    />
  )
}

/** Nav row / list row */
export function NavRow({
  children,
  on = false,
  indent = 0,
  right,
}: {
  children: ReactNode
  on?: boolean
  indent?: number
  right?: ReactNode
}) {
  return (
    <div
      className={`flex items-center gap-2 rounded-[var(--wire-radius)] py-1.5 pr-2 text-sm ${
        on ? 'bg-[var(--wire-muted)] font-medium text-[var(--wire-fg)]' : 'text-[var(--wire-muted-fg)]'
      }`}
      style={{ paddingLeft: 10 + indent }}
    >
      <span className="flex-1 truncate">{children}</span>
      {right}
    </div>
  )
}

/** Group heading */
export function GroupLabel({ children }: { children: ReactNode }) {
  return (
    <div className="px-2.5 pt-4 pb-1 text-[11px] font-medium tracking-wide text-[var(--wire-muted-fg)]">
      {children}
    </div>
  )
}

/** Non-happy-path states: one centred line plus one action. Placement rules in layout.md §8. */
export function StateBlock({
  kind,
  text,
  action,
}: {
  kind: 'empty' | 'loading' | 'partial-failure' | 'region-failure'
  text: string
  action?: string
}) {
  return (
    <div className="flex h-full flex-col items-center justify-center gap-2 p-6 text-center">
      <span className="rounded border border-[var(--wire-line)] px-1.5 py-0.5 font-mono text-[10px] text-[var(--wire-muted-fg)]">
        {kind}
      </span>
      <p className="max-w-[280px] text-xs text-[var(--wire-muted-fg)]">{text}</p>
      {action && <Btn weight="outline">{action}</Btn>}
    </div>
  )
}
