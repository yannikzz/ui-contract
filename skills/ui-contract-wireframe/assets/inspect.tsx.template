/**
 * Inspect apparatus. Starting point for <wireframe>/src/inspect.tsx.
 *
 * **This file IS the wireframe's colour exemption.** The exemption is a file, not a
 * marker inside a file. Everything here is apparatus and never a product surface:
 * region badges, the region outline, the tooltip, the skin-preview banner, the skin
 * editor, and the whole browser chrome — viewport, corners, panel, zones, wall.
 *
 * All of it carries fixed colour values on purpose. Every surface here is something
 * you use to control or interpret the wireframe, so it has to stay readable no matter
 * what the skin does — which means none of it may follow the skin. Three of these were
 * measured, not reasoned:
 *
 *   - A tooltip tinted by the theme it describes stops being able to describe it.
 *   - A warning banner tinted by the values it warns about can vanish. The first
 *     version used --wire-strong / --wire-strong-fg; a pale brand colour turned it
 *     white-on-white, so the guard disappeared exactly where the theme made it
 *     hardest to notice. A warning may not depend on what it warns about.
 *   - The panel holds the control that turns the skin OFF. Skin that, and a bad
 *     theme becomes a trap you cannot get out of.
 *
 * The browser around the projection has four parts and ONE placement rule, and the
 * rule is enforced by the components below rather than by anyone's judgement:
 *
 *   Browser    the page frame: white, holds the viewport column and the panel.
 *              App.tsx carries no colour, so the frame's white lives here
 *   Viewport   the light-grey rounded area; the projection lives inside it
 *   Corners    inside the viewport — only what acts on the VIEWPORT (view switch,
 *              lens, fit, canvas background). A closed set, owned by Viewport
 *   Panel      outside the viewport — only what acts on the PROTOTYPE. Its children
 *              are Zones; Zone requires a zone; Panel orders them. Nothing in App.tsx
 *              decides where a control goes
 *   Wall       the viewport's second view: every archetype × state × width tier.
 *              It draws no arrows — nothing on it may lack a clause in layout.md
 *
 * The exports below are a CLOSED, DECLARED list, and this is where it is declared:
 *
 * APPARATUS: LabelsProvider useLabels AnnotatedRegion SkinBanner SkinEditor toHex ViewMode PanelZone Browser Viewport Panel Zone Choice Readout Alert Wall
 *
 * That line is the decision, and it lives here because here is where the decision is
 * made — adding a name to it shows up in a diff of this file, next to the thing being
 * added. `check-colours.sh` READS it and carries no copy of its own, so adding a name is
 * one edit in one place.
 *
 * ⚠ The `APPARATUS:` marker stays ASCII even when this comment is written in the
 * deliverable's language — same rule as the paths table's Key column and the
 * declaration table's three keywords, and the same failure if it is translated: the
 * readers stop finding it. `check-colours.sh` is required to fail loudly when it is
 * missing rather than treat "no declaration" as "nothing declared". Moving a product
 * component in here would buy it the right to hardcode colour, so adding a name has to be a
 * decision somebody wrote down — and a file move is visible in a diff in a way that
 * relocating two comment markers is not.
 *
 * Everything that is NOT apparatus lives in wire.tsx and takes its colour through
 * var(--wire-*). The only values there are the NEUTRAL map.
 */
import { Children, createContext, isValidElement, useContext, useEffect, useLayoutEffect, useRef, useState } from 'react'
import { createPortal } from 'react-dom'
import type { CSSProperties, ReactElement, ReactNode, RefObject } from 'react'

// TODO point this at the project's asset layer (the file produced by ui-contract-assets).
// The wireframe imports from the asset layer; never the reverse.
// The depth below is counted from the default location, `.ui-contract-local/wireframe/src/`:
// three levels up is the repo root. Re-count it if the wireframe is put somewhere else.
import { Region, REGION_META, type RegionId } from '../../../src/ui/region'

// SKIN is the role -> token-name map; the editor builds its fields from it. It lives
// in wire.tsx with the other colour declarations, not here.
import { SKIN } from './wire'

const LabelsCtx = createContext(false)
export const LabelsProvider = LabelsCtx.Provider
export const useLabels = () => useContext(LabelsCtx)

const TIP_W = 300

/**
 * Region badge. The tooltip is portalled to document.body with fixed positioning:
 * ancestors' overflow-hidden can't clip it, and it doesn't compete in the
 * prototype's stacking contexts — z-index alone can't fix this, because
 * clipping ignores z-index.
 *
 * Flip direction and horizontal clamping are computed from real viewport space,
 * so there's no hand-maintained list of "regions that open upward".
 */
function RegionLabel({ id, text, desc }: { id: RegionId; text: string; desc: string }) {
  const ref = useRef<HTMLSpanElement>(null)
  const [tip, setTip] = useState<{ left: number; top: number; up: boolean } | null>(null)

  const show = () => {
    const el = ref.current
    if (!el) return
    const r = el.getBoundingClientRect()
    const up = r.bottom + 8 + 120 > window.innerHeight
    setTip({
      left: Math.min(Math.max(8, r.left), Math.max(8, window.innerWidth - TIP_W - 8)),
      top: up ? r.top - 4 : r.bottom + 4,
      up,
    })
  }

  return (
    <span
      ref={ref}
      onMouseEnter={show}
      onMouseLeave={() => setTip(null)}
      className="absolute -top-px left-0 z-10 cursor-help rounded-br bg-sky-600/85 px-1 text-[10px] leading-[15px] font-medium whitespace-nowrap text-white hover:bg-sky-700"
    >
      {text}
      {tip &&
        createPortal(
          <div
            style={{
              position: 'fixed',
              left: tip.left,
              top: tip.top,
              width: TIP_W,
              transform: tip.up ? 'translateY(-100%)' : undefined,
              zIndex: 9999,
            }}
            /* The annotation overlay stays hard-coded dark on purpose: it is inspect
               chrome, not a product surface, so it must NOT follow the skin. Skinning
               it would put the tooltip inside the thing the tooltip is describing. */
            className="pointer-events-none rounded-lg border border-neutral-700 bg-neutral-900 p-2.5 shadow-xl"
          >
            <p className="font-mono text-[10px] break-all text-sky-300">data-region="{id}"</p>
            {/* whitespace-normal is required: nowrap on the badge would inherit and overflow */}
            <p className="mt-1 text-[11px] leading-relaxed font-normal break-words whitespace-normal text-neutral-200">
              {desc}
            </p>
          </div>,
          document.body,
        )}
    </span>
  )
}

/**
 * Annotated wrapper around the asset layer's `Region`.
 *
 * The wireframe renders every structural container through this; production code
 * renders through the bare `Region`. Same id space, same runtime marker — the only
 * difference is the inspect overlay, which is why it lives here and not there.
 */
export function AnnotatedRegion({
  id,
  children,
  className = '',
  style,
  label,
  elRef,
}: {
  id: RegionId
  children?: ReactNode
  className?: string
  /** Computed structural values — a degradation rule has to be visibly live, not a fixed class */
  style?: CSSProperties
  /** Overrides the badge label (e.g. a region's collapsed form) */
  label?: string
  elRef?: RefObject<HTMLDivElement | null>
}) {
  const on = useLabels()
  const meta = REGION_META[id]
  return (
    <Region
      id={id}
      elRef={elRef}
      style={style}
      className={`${className} ${on ? 'relative outline-1 outline-dashed outline-sky-500/50' : ''}`}
    >
      {on && <RegionLabel id={id} text={label ?? meta.label} desc={meta.desc} />}
      {children}
    </Region>
  )
}

/**
 * The marker that travels with a screenshot.
 *
 * The failure this guards against: six months on nobody remembers the preview
 * defaults to off, an agent opens it, screenshots it, and copies from there.
 * Default-off does not reach that agent — a picture does. Render this whenever
 * the preview is on, and do not make it dismissible.
 *
 * Its colours are FIXED, and that is the whole point. The first version painted
 * it with --wire-strong / --wire-strong-fg and it came out tinted by the very
 * skin it was warning about: map --wire-strong to a pale brand colour and the
 * banner goes white-on-white, i.e. the guard disappears exactly when the theme
 * makes it hardest to notice. A warning may not depend on what it warns about.
 */
export function SkinBanner({ tokenFile }: { tokenFile: string }) {
  return (
    <div className="bg-amber-400 px-3 py-1 text-center font-mono text-[11px] font-medium text-neutral-950">
      SKIN PREVIEW ON · values are read live from {tokenFile} · do not copy them from here
    </div>
  )
}

/**
 * Skin editor. Turns the preview from "look" into "look and adjust" — the reason
 * being that only the wireframe shows this product's real IA, so it is the only
 * place where "that spacing is wrong at this density" can be noticed AND acted on.
 *
 * It writes nothing. Values live in memory; the output is a prompt you hand to an
 * agent, which edits tokens.input.json. The instrument stays the JSON's only
 * writer, so two open editors cannot overwrite each other.
 *
 * KNOWN COST, accepted deliberately: the hop from "turned a knob here" to "the
 * JSON changed" goes through an agent and is not recorded. Do not paper over it.
 */
/**
 * Two values are the same value if they resolve to the same colour, even when
 * they are written differently.
 *
 * Without this, opening the native colour picker and closing it again rewrites
 * `oklch(0.47 0.15 258)` as `#1a57ad` — identical colour, different notation —
 * and the prompt reports it as a change. **A prompt that invents changes is
 * worse than no prompt**: an agent applying it would quietly convert the
 * project's colour space to hex, and the user never asked for that.
 *
 * Non-colours (a radius, a length) fall back to string comparison.
 */
function sameValue(a: string, b: string): boolean {
  if (a === b) return true
  const ha = toHex(a)
  const hb = toHex(b)
  return ha !== null && hb !== null && ha === hb
}

export function SkinEditor({
  base,
  draft,
  onChange,
  onReset,
  tokenFile,
  theme,
  chosen,
  themeLabel,
}: {
  /** what the token file currently says, per --wire-* role */
  base: Record<string, string>
  /** edited values, per role; absent means unchanged */
  draft: Record<string, string>
  onChange: (role: string, value: string) => void
  onReset: () => void
  tokenFile: string
  /** the direction currently previewed */
  theme: string
  /** the direction design.md §1 already settled on */
  chosen: string
  themeLabel: (id: string) => string
}) {
  // Three states, not a boolean. **"copy failed" and "not clicked yet" must not share
  // one** — merged, a failure looks like an untouched button while the user already
  // believes they hold the text.
  const [copyState, setCopyState] = useState<'idle' | 'ok' | 'failed'>('idle')
  const taRef = useRef<HTMLTextAreaElement>(null)
  const rows = Object.entries(SKIN).filter(([, token]) => token)
  const changed = rows
    .map(([role, token]) => ({ role, token, from: base[role] ?? '', to: draft[role] }))
    .filter((r) => r.to !== undefined && !sameValue(r.from, r.to))

  // Switching direction and tuning a token are **two different things**, and the prompt
  // must not flatten them into one.
  //
  // A direction change is an `originate` Step 1 decision: the document changes first
  // (§1 — the direction, its cost, whether the hue basis moves), then the values are
  // re-derived, then the structural numbers that depend on the scale get re-checked.
  // Emitting a token diff instead sends an agent to edit the token file while the
  // document still names the old direction — **the document says one thing and the
  // values say another**, which is the second authority this whole split prevents.
  //
  // So the direction section comes first, and it carries a process, not numbers.
  //
  // TODO both sections in the deliverable's language. The shapes are what matter:
  // exact old -> new for edits, and document-first ordering for a direction change.
  const switched = theme !== chosen
  const lines: string[] = []
  if (switched) {
    lines.push(
      `Prefer ${themeLabel(theme)} over the settled ${themeLabel(chosen)}, seen at real density.`,
      ``,
      `This is a DIRECTION change, not a tuning change. The order does not reverse:`,
      `  1. design.md §1 first — the direction, its cost, and whether the hue basis moves`,
      `  2. re-derive the values from the new coordinates into ${tokenFile}`,
      `  3. re-check the structural numbers that depend on the scale (layout.md)`,
      ``,
      `Do not skip step 1 and edit tokens — that leaves the document naming one direction`,
      `and the values carrying another.`,
    )
  }
  if (changed.length) {
    if (switched) lines.push(``, `Also tuned by hand on top of ${themeLabel(theme)}:`, ``)
    else
      lines.push(
        `Update ${tokenFile}. These were tuned in the wireframe against it;`,
        `the wireframe stores nothing, so nothing has been written yet.`,
        ``,
      )
    lines.push(...changed.map((c) => `  ${c.token}  ${c.from}  ->  ${c.to}`))
    lines.push(``, `Keep the names exactly as written — design.md is the name authority.`)
  }
  const prompt = lines.join('\n')

  return (
    <div className="text-[11px] text-neutral-800">
      <div className="mb-1.5 flex items-center gap-2">
        <span className="font-mono text-neutral-500">skin editor</span>
        <span className="text-neutral-500">
          {changed.length ? `${changed.length} changed` : 'no changes'}
        </span>
        <button
          className="ml-auto rounded border border-neutral-300 px-1.5 py-0.5 hover:bg-neutral-100"
          onClick={onReset}
        >
          reset
        </button>
        <button
          className="rounded border border-amber-400 bg-amber-400 px-1.5 py-0.5 font-medium text-neutral-950 disabled:opacity-40"
          disabled={!prompt}
          onClick={async () => {
            // The clipboard API does not exist in a non-secure context — opened over a
            // LAN IP, or with permission refused. The first version wrote
            // `navigator.clipboard?.writeText(...)`, so it silently did nothing and then
            // reported success: **it lied**, about the one thing that carries
            // the user's intent in this path. Report what actually happened,
            // and on failure select the text so it can still be taken by hand.
            try {
              if (!navigator.clipboard) throw new Error('no clipboard in this context')
              await navigator.clipboard.writeText(prompt)
              setCopyState('ok')
            } catch {
              setCopyState('failed')
              taRef.current?.select()
            }
            setTimeout(() => setCopyState('idle'), 2500)
          }}
        >
          {copyState === 'ok' ? 'copied' : copyState === 'failed' ? 'selected — press ⌘C' : 'copy prompt'}
        </button>
      </div>
      {prompt ? (
        <textarea
          ref={taRef}
          readOnly
          value={prompt}
          onFocus={(e) => e.currentTarget.select()}
          rows={Math.min(10, prompt.split('\n').length)}
          className="mb-1.5 w-full resize-y rounded border border-neutral-200 bg-neutral-50 p-1.5 font-mono text-[10px] leading-relaxed text-neutral-800"
        />
      ) : (
        // Say why the button is grey. Left as bare `disabled`, it reads as broken.
        <p className="mb-1.5 text-neutral-500">TODO, in the deliverable's language: change a value and the prompt appears here.</p>
      )}
      <div className="grid grid-cols-1 gap-y-1">
        {rows.map(([role, token]) => {
          const cur = draft[role] ?? base[role] ?? ''
          const dirty = draft[role] !== undefined && !sameValue(base[role] ?? '', draft[role])
          const hex = toHex(cur)
          return (
            <label key={role} className="flex items-center gap-1.5">
              <span
                className={`w-28 shrink-0 truncate font-mono ${dirty ? 'text-amber-700' : 'text-neutral-500'}`}
                title={`${token}  (${role})`}
              >
                {token}
              </span>
              {hex && (
                <input
                  type="color"
                  // `<input type="color">` only accepts `#rrggbb`. Slicing the
                  // alpha off is display-only: `cur` keeps the full value, and
                  // sameValue still compares all eight digits. Picking a colour
                  // here does drop the alpha — that is a real edit the user
                  // made, and it now shows up as one instead of vanishing.
                  value={hex.slice(0, 7)}
                  onChange={(e) => onChange(role, e.target.value)}
                  className="h-5 w-6 shrink-0 rounded border border-neutral-300 bg-transparent p-0"
                />
              )}
              <input
                type="text"
                value={cur}
                onChange={(e) => onChange(role, e.target.value)}
                className="min-w-0 flex-1 rounded border border-neutral-300 bg-white px-1 py-0.5 font-mono text-neutral-800"
              />
            </label>
          )
        })}
      </div>
    </div>
  )
}

/**
 * Resolve any CSS colour to #rrggbb by PAINTING it, so oklch()/lab()/color()
 * work. Reading digits out of getComputedStyle does not: modern browsers keep
 * `oklch(...)` as `oklch(...)`, and scraping it reads lightness/chroma/hue as
 * if they were r/g/b — no error, plausible numbers, all wrong.
 *
 * There is a second copy of this in the tuning instrument's template. They
 * cannot share code: one is an HTML template, the other a tsx template, in two
 * packages, and cross-package references are forbidden. If the two ever
 * disagree, the symptom is the same value shown differently in the two tools,
 * with nothing reporting an error.
 */
let cx: CanvasRenderingContext2D | null = null
export function toHex(v: string): string | null {
  if (typeof window === 'undefined' || !v?.trim()) return null
  if (!cx) {
    const c = document.createElement('canvas')
    c.width = c.height = 1
    cx = c.getContext('2d', { willReadFrequently: true })
  }
  if (!cx) return null
  // An invalid value leaves the previous fillStyle standing, so two different
  // sentinels tell "rejected" apart from "happens to equal the sentinel".
  cx.fillStyle = '#010203'
  cx.fillStyle = v
  const a = cx.fillStyle
  cx.fillStyle = '#040506'
  cx.fillStyle = v
  if (a !== cx.fillStyle) return null
  cx.clearRect(0, 0, 1, 1)
  cx.fillRect(0, 0, 1, 1)
  const d = cx.getImageData(0, 0, 1, 1).data
  // Alpha is part of the value, so it is part of the identity: `#rrggbbaa` when
  // the colour is translucent, `#rrggbb` when it is not. Returning six digits
  // always is what made `sameValue` blind — rgba(0,0,0,.4) and rgba(0,0,0,.8)
  // both resolved to `#000000`, so an opacity edit was reported as no edit:
  // no dirty marker, and nothing in the prompt. The prompt is the only carrier
  // of the user's intent, and a change that never reaches it is a change that
  // never happened.
  const n = (x: number) => x.toString(16).padStart(2, '0')
  const rgb = '#' + n(d[0]) + n(d[1]) + n(d[2])
  return d[3] === 255 ? rgb : rgb + n(d[3])
}

// ── The browser chrome ────────────────────────────────────────
/**
 * Four parts, one rule: a control that changes HOW you look goes in a corner; one
 * that changes WHAT you look at goes in the panel. The rule lives in these
 * components — Viewport owns the corners, Panel accepts only Zones, Zone requires
 * a zone, Choice picks its own widget — so App.tsx composes and decides nothing.
 *
 * All of this is chrome: light, fixed colours, never following the skin. The
 * one closed exception to the rule is the panel's own collapse/expand — an
 * operation that must stay visible, or there is no way back in.
 */

/** The two views the viewport can show. */
export type ViewMode = 'proto' | 'wall'

/**
 * The panel's zones, by what the control changes. A CLOSED union: a control that
 * fits none of them is a control that acts on the viewport, and belongs in a corner.
 */
export type PanelZone = 'screen' | 'condition' | 'view' | 'output'
const ZONE_ORDER: readonly PanelZone[] = ['screen', 'condition', 'view', 'output']
// TODO zone titles in the deliverable's language. Two words each; no subtitles.
const ZONE_TITLE: Record<PanelZone, string> = {
  screen: 'TODO screen',
  condition: 'TODO condition',
  view: 'TODO view',
  output: 'TODO output',
}

const ZOOM_MIN = 0.1
const ZOOM_MAX = 3
const clampZoom = (z: number) => Math.min(ZOOM_MAX, Math.max(ZOOM_MIN, +z.toFixed(3)))

function CornerBtn({
  on,
  mono,
  title,
  onClick,
  children,
}: {
  on?: boolean
  mono?: boolean
  title?: string
  onClick: () => void
  children: ReactNode
}) {
  return (
    <button
      title={title}
      onClick={onClick}
      className={`inline-flex h-6 min-w-6 items-center justify-center rounded-[5px] px-1.5 text-[11px] hover:bg-neutral-100 hover:text-neutral-900 ${
        on ? 'bg-neutral-100 font-medium text-neutral-900' : 'text-neutral-500'
      } ${mono ? 'min-w-11 font-mono' : ''}`}
    >
      {children}
    </button>
  )
}

/**
 * The page frame. White, fixed: it is chrome, and App.tsx may carry no colour of
 * its own. `children` is the viewport column (banner above, viewport below);
 * `panel` sits to the right, outside the viewport, with no line between them —
 * the viewport's grey edge is the boundary.
 */
export function Browser({ panel, children }: { panel: ReactNode; children: ReactNode }) {
  return (
    <div className="flex h-screen bg-white font-sans text-neutral-900">
      <div className="flex min-w-0 flex-1 flex-col gap-2.5 p-3.5">{children}</div>
      {panel}
    </div>
  )
}

/**
 * The viewport: the projection lives inside it, the panel lives outside it.
 *
 * It owns the lens and the corners. The lens is a CSS `zoom`, which scales the box
 * in layout — so scrolling follows it, the anchor maths is one line, and the
 * MEASURED width does not move: `offsetWidth` and ResizeObserver report unzoomed
 * layout pixels. **Never derive the shell width from getBoundingClientRect divided
 * by the lens.** Measured: with a transition on the lens and that division in the
 * reading, every pinch tick measured mid-animation, the shell width jittered, and
 * the degradation flipped with it. The lens has no transition for the same reason.
 *
 * Pinch and ⌘+wheel are intercepted so the browser does not zoom the page. In wall
 * mode the zoom is anchored at the cursor and the canvas pans by dragging. There
 * are no scrollbars; wheel and drag move the canvas.
 */
export function Viewport({
  mode,
  onMode,
  zoom,
  onZoom,
  clamp = 0,
  wall,
  children,
}: {
  mode: ViewMode
  onMode: (m: ViewMode) => void
  zoom: number
  onZoom: (z: number) => void
  /** the width tier the prototype is clamped to; 0 = fluid */
  clamp?: number
  /** the wall. Omit it and the view switch is not rendered — an empty corner does not render */
  wall?: ReactNode
  children: ReactNode
}) {
  const vp = useRef<HTMLDivElement>(null)
  const sc = useRef<HTMLDivElement>(null)
  const wallEl = useRef<HTMLDivElement>(null)
  const stageEl = useRef<HTMLDivElement>(null)
  const [dark, setDark] = useState(false)
  const [dragging, setDragging] = useState(false)
  // Latest values for the non-React listeners below, so they are attached once.
  const live = useRef({ mode, zoom, onZoom })
  live.current = { mode, zoom, onZoom }
  // The point to keep still across a zoom: (ax, ay) in the anchor element's own
  // unzoomed coordinates, (cx, cy) where it sits on screen. Applied after React has
  // re-rendered at the new zoom, by measuring where the element actually landed —
  // so the moment the prototype outgrows the viewport and stops being centred,
  // nothing jumps. getBoundingClientRect here is a POSITION reading, never a width.
  const anchorEl = () => (live.current.mode === 'wall' ? wallEl.current : stageEl.current)
  const pendingAnchor = useRef<{ ax: number; ay: number; cx: number; cy: number } | null>(null)
  const zoomTo = (next: number, cx: number, cy: number) => {
    const { zoom, onZoom } = live.current
    if (next === zoom) return
    const el = anchorEl()
    if (el) {
      const r = el.getBoundingClientRect()
      pendingAnchor.current = { ax: (cx - r.left) / zoom, ay: (cy - r.top) / zoom, cx, cy }
    }
    onZoom(next)
  }
  const zoomToRef = useRef(zoomTo)
  zoomToRef.current = zoomTo
  // Buttons have no cursor, so they anchor at the viewport's centre — which, when the
  // prototype fits, is the prototype's centre.
  const zoomAtCentre = (next: number) => {
    const el = vp.current
    if (!el) return
    const r = el.getBoundingClientRect()
    zoomTo(next, r.left + el.clientWidth / 2, r.top + el.clientHeight / 2)
  }

  useLayoutEffect(() => {
    const a = pendingAnchor.current
    const s = sc.current
    const el = anchorEl()
    if (!a || !s || !el) return
    const r = el.getBoundingClientRect()
    s.scrollLeft += r.left + a.ax * live.current.zoom - a.cx
    s.scrollTop += r.top + a.ay * live.current.zoom - a.cy
    pendingAnchor.current = null
  })

  useEffect(() => {
    const el = vp.current
    const s = sc.current
    if (!el || !s) return
    // Anchored at the cursor, in both modes.
    const zoomAt = (factor: number, cx: number, cy: number) =>
      zoomToRef.current(clampZoom(live.current.zoom * factor), cx, cy)
    // A trackpad pinch arrives as wheel + ctrlKey; ⌘+wheel is the same gesture on a mouse.
    const onWheel = (e: WheelEvent) => {
      if (!e.ctrlKey && !e.metaKey) return
      e.preventDefault()
      zoomAt(Math.exp(-e.deltaY * 0.01), e.clientX, e.clientY)
    }
    // Safari also fires gesture events; without these it zooms the page.
    type GestureEvt = Event & { scale?: number; clientX?: number; clientY?: number }
    let last = 1
    const onGestureStart = (e: Event) => {
      e.preventDefault()
      last = 1
    }
    const onGestureChange = (e: GestureEvt) => {
      e.preventDefault()
      const scale = e.scale ?? 1
      zoomAt(scale / last, e.clientX ?? 0, e.clientY ?? 0)
      last = scale
    }
    const onGestureEnd = (e: Event) => e.preventDefault()
    el.addEventListener('wheel', onWheel, { passive: false })
    el.addEventListener('gesturestart', onGestureStart, { passive: false })
    el.addEventListener('gesturechange', onGestureChange, { passive: false })
    el.addEventListener('gestureend', onGestureEnd, { passive: false })
    return () => {
      el.removeEventListener('wheel', onWheel)
      el.removeEventListener('gesturestart', onGestureStart)
      el.removeEventListener('gesturechange', onGestureChange)
      el.removeEventListener('gestureend', onGestureEnd)
    }
  }, [])

  // Drag to pan, wall mode only. Window listeners so a fast drag does not drop out.
  useEffect(() => {
    const s = sc.current
    if (!s) return
    let drag: { x: number; y: number; l: number; t: number } | null = null
    const down = (e: MouseEvent) => {
      if (live.current.mode !== 'wall' || e.button !== 0) return
      drag = { x: e.clientX, y: e.clientY, l: s.scrollLeft, t: s.scrollTop }
      setDragging(true)
    }
    const move = (e: MouseEvent) => {
      if (!drag) return
      s.scrollLeft = drag.l - (e.clientX - drag.x)
      s.scrollTop = drag.t - (e.clientY - drag.y)
    }
    const up = () => {
      drag = null
      setDragging(false)
    }
    s.addEventListener('mousedown', down)
    window.addEventListener('mousemove', move)
    window.addEventListener('mouseup', up)
    return () => {
      s.removeEventListener('mousedown', down)
      window.removeEventListener('mousemove', move)
      window.removeEventListener('mouseup', up)
    }
  }, [])

  const fit = () => {
    const el = vp.current
    if (!el) return
    if (mode === 'wall' && wallEl.current) {
      // The whole wall in one screen: whichever axis is tighter.
      const w = wallEl.current.offsetWidth
      const h = wallEl.current.offsetHeight
      zoomAtCentre(clampZoom(Math.min(1, el.clientWidth / w, el.clientHeight / h)))
    } else {
      const avail = el.clientWidth - 40
      zoomAtCentre(clampZoom(Math.min(1, avail / (clamp || avail))))
    }
  }

  const corner =
    'absolute bottom-3 z-10 flex h-8 items-center gap-0.5 rounded-lg border border-neutral-200 bg-white p-[3px] text-neutral-900 shadow-[0_1px_2px_rgba(0,0,0,.06),0_4px_12px_rgba(0,0,0,.06)]'

  return (
    <div
      ref={vp}
      data-canvas={dark ? 'dark' : 'light'}
      className={`group relative min-h-0 flex-1 overflow-hidden rounded-xl border ${
        dark ? 'border-neutral-700 bg-neutral-800' : 'border-neutral-200 bg-neutral-100'
      }`}
    >
      <div
        ref={sc}
        className={`absolute inset-0 overflow-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden ${
          mode === 'wall' ? (dragging ? 'cursor-grabbing select-none' : 'cursor-grab') : ''
        }`}
      >
        {mode === 'proto' ? (
          <div className="flex min-h-full p-5 pb-16" style={{ justifyContent: 'safe center', alignItems: 'safe center' }}>
            <div ref={stageEl} className="shrink-0" style={{ width: clamp || '100%', zoom }}>
              {children}
            </div>
          </div>
        ) : (
          <div ref={wallEl} className="w-max p-6 pb-20" style={{ zoom }}>
            {wall}
          </div>
        )}
      </div>

      {wall !== undefined && (
        <div className={`${corner} left-3`}>
          <CornerBtn on={mode === 'proto'} onClick={() => onMode('proto')}>
            TODO prototype
          </CornerBtn>
          <CornerBtn on={mode === 'wall'} onClick={() => onMode('wall')}>
            TODO wall
          </CornerBtn>
        </div>
      )}
      <div className={`${corner} right-3`}>
        <CornerBtn title="TODO zoom out" onClick={() => zoomAtCentre(clampZoom(zoom - 0.1))}>
          −
        </CornerBtn>
        <CornerBtn mono title="TODO reset to 100%" onClick={() => zoomAtCentre(1)}>
          {Math.round(zoom * 100)}%
        </CornerBtn>
        <CornerBtn title="TODO zoom in" onClick={() => zoomAtCentre(clampZoom(zoom + 0.1))}>
          +
        </CornerBtn>
        <CornerBtn title="TODO fit to viewport" onClick={fit}>
          TODO fit
        </CornerBtn>
        <span className="mx-0.5 h-4 w-px bg-neutral-200" />
        <CornerBtn on={dark} title="TODO canvas background" onClick={() => setDark(!dark)}>
          ◐
        </CornerBtn>
      </div>
    </div>
  )
}

type ZoneProps = { zone: PanelZone; children?: ReactNode }

/**
 * One zone of the panel. `zone` is required and closed, so a control cannot be
 * placed without saying what it changes. An empty zone renders nothing — the
 * wizard-step control disappears with the wizard, not into an empty heading.
 *
 * The output zone is set apart on purpose: it is the only zone whose result flows
 * back into the project (the editor's prompt). Everything else dies with the tab.
 */
export function Zone({ zone, children }: ZoneProps) {
  if (Children.toArray(children).length === 0) return null
  const out = zone === 'output'
  return (
    <section className={`border-t border-neutral-200 px-3.5 pt-3 pb-3.5 ${out ? 'bg-neutral-50' : ''}`}>
      <div className={`mb-2.5 text-[11px] font-semibold ${out ? 'text-amber-700' : 'text-neutral-900'}`}>
        {ZONE_TITLE[zone]}
      </div>
      {children}
    </section>
  )
}

/**
 * The panel. It takes Zones and nothing else, and it orders them — App.tsx cannot
 * put a control first, last, or outside a zone. In wall mode the screen and
 * condition zones are dropped (they have become the wall's axes) and so is the
 * readout (there is no "current" screen).
 *
 * Collapsed, it has to remain a thing that reads as clickable. The first version
 * left an empty 560px strip — same width, nothing in it — which read as a
 * leftover, and the user could not find the way back.
 */
export function Panel({
  open,
  onToggle,
  mode,
  title,
  readout,
  children,
}: {
  open: boolean
  onToggle: () => void
  mode: ViewMode
  /** TODO the panel's name, in the deliverable's language */
  title: string
  /** the readout block; hidden in wall mode */
  readout?: ReactNode
  children?: ReactNode
}) {
  if (!open) {
    return (
      <button
        onClick={onToggle}
        className="fixed top-1/2 right-0 z-50 -translate-y-1/2 rounded-l-lg border border-r-0 border-neutral-200 bg-white px-2 py-2.5 text-[11px] tracking-widest text-neutral-900 shadow-md [writing-mode:vertical-rl] hover:bg-neutral-100"
      >
        ⚙ {title}
      </button>
    )
  }
  const kids = Children.toArray(children)
  for (const z of kids) {
    if (!isValidElement(z) || z.type !== Zone) {
      // Loud on purpose. TypeScript cannot check a JSX child's component, so the
      // rule "nothing sits in the panel outside a zone" is held here, at render.
      throw new Error('Panel accepts <Zone> children only — a control outside a zone has no place')
    }
  }
  const zones = kids as ReactElement<ZoneProps>[]
  const hidden: readonly PanelZone[] = mode === 'wall' ? ['screen', 'condition'] : []
  const ordered = ZONE_ORDER.filter((k) => !hidden.includes(k)).flatMap((k) =>
    zones.filter((z) => z.props.zone === k),
  )
  return (
    <aside className="flex w-[288px] shrink-0 flex-col bg-white pr-1 text-neutral-900">
      <div className="flex shrink-0 items-center justify-between px-3.5 pt-3 pb-2.5">
        <span className="text-xs font-semibold">{title}</span>
        <button
          onClick={onToggle}
          title="TODO collapse"
          className="inline-flex h-[26px] w-[26px] items-center justify-center rounded-md border border-neutral-200 text-xs text-neutral-500 hover:bg-neutral-100 hover:text-neutral-900"
        >
          ›
        </button>
      </div>
      {/* readout OUTSIDE the scroller: it stays put while the zones scroll */}
      {mode === 'proto' && <div className="shrink-0">{readout}</div>}
      <div className="min-h-0 flex-1 overflow-y-auto">{ordered}</div>
    </aside>
  )
}

type ChoiceBool = {
  label: string
  value: boolean
  onChange: (v: boolean) => void
  options?: undefined
}
type ChoiceOne<T extends string | number> = {
  label: string
  options: readonly T[]
  value: T
  onChange: (v: T) => void
  labelOf?: (v: T) => string
}

/**
 * The one control. Its shape is a function of the data, and the caller never
 * picks it: a boolean is a switch, up to four exclusive options are a segmented
 * control, five or more are a dropdown. "Can choose" is where inconsistency gets
 * in; this removes the choice, the same way Panel removes the ordering.
 */
export function Choice<T extends string | number>(p: ChoiceBool | ChoiceOne<T>) {
  let widget: ReactNode
  if (p.options === undefined) {
    widget = (
      <button
        role="switch"
        aria-checked={p.value}
        onClick={() => p.onChange(!p.value)}
        className={`relative h-[18px] w-[30px] rounded-full transition-colors ${p.value ? 'bg-neutral-900' : 'bg-neutral-300'}`}
      >
        <span
          className={`absolute top-0.5 h-3.5 w-3.5 rounded-full bg-white shadow-sm transition-[left] ${p.value ? 'left-[14px]' : 'left-0.5'}`}
        />
      </button>
    )
  } else if (p.options.length <= 4) {
    const { options, value, onChange, labelOf } = p
    widget = (
      <div className="inline-flex max-w-full gap-0.5 rounded-[7px] bg-neutral-100 p-0.5">
        {options.map((o) => (
          <button
            key={o}
            onClick={() => onChange(o)}
            className={`rounded-[5px] px-2 py-[3px] text-[11px] whitespace-nowrap ${
              o === value ? 'bg-white font-medium text-neutral-900 shadow-[0_1px_2px_rgba(0,0,0,.08)]' : 'text-neutral-500'
            }`}
          >
            {labelOf ? labelOf(o) : o}
          </button>
        ))}
      </div>
    )
  } else {
    const { options, value, onChange, labelOf } = p
    widget = (
      <select
        value={value}
        onChange={(e) => onChange(options[e.target.selectedIndex])}
        className="rounded-md border border-neutral-200 bg-white px-2 py-[3px] text-[11px] text-neutral-900"
      >
        {options.map((o) => (
          <option key={o} value={o}>
            {labelOf ? labelOf(o) : o}
          </option>
        ))}
      </select>
    )
  }
  return (
    <div className="mb-2 flex min-h-[26px] items-center gap-2.5 last:mb-0">
      <label className="w-[60px] shrink-0 text-[11px] text-neutral-500">{p.label}</label>
      <div className="min-w-0 flex-1">{widget}</div>
    </div>
  )
}

/**
 * The readout block: measured numbers, pinned above the zones. A degradation rule
 * has to be checkable against numbers rather than by feel, so print the measured
 * width, the lens scale, each column's resolved state, the threshold, and which
 * steps fired. Wrap a value in <b> to make it read as the number.
 */
export function Readout({ children }: { children: ReactNode }) {
  return (
    <div className="mx-3.5 mb-1.5 grid grid-cols-2 gap-x-3 gap-y-1 rounded-lg bg-neutral-100 px-3 py-2 font-mono text-[10.5px] leading-normal text-neutral-500 [&_b]:font-semibold [&_b]:text-neutral-900">
      {children}
    </div>
  )
}

/**
 * A readout value that means a rule fired. Fixed colour, same reason as everything
 * else here: a readout you cannot read under the current skin cannot report on it.
 */
export function Alert({ children }: { children: ReactNode }) {
  return <span className="col-span-2 font-semibold text-amber-700">{children}</span>
}

/**
 * The wall: every archetype × every state × every width tier, side by side.
 * The rows and columns are the caller's — they come from layout.md §4, §8 and
 * §3.4 — and `render` is the shell at that column's width. **It draws no arrows.**
 * layout.md has no clause for how a user gets from one screen to the next, so a
 * connector here would be the wireframe inventing structure.
 *
 * Each tile is the shell laid out at its real width and shown through a CSS zoom,
 * so the density on a tile is the density at that tier.
 */
export function Wall({
  rows,
  cols,
  scale = 0.28,
  tileHeight = 640,
  render,
  caption,
}: {
  rows: readonly { id: string; label: string; sub?: string }[]
  cols: readonly { id: string; label: string; sub?: string; width: number }[]
  scale?: number
  /** the shell's height inside a tile, in layout pixels */
  tileHeight?: number
  render: (rowId: string, colId: string, width: number) => ReactNode
  caption?: (rowId: string, colId: string) => string
}) {
  const tpl = `120px ${cols.map((c) => Math.round(c.width * scale) + 'px').join(' ')}`
  return (
    <div className="text-neutral-900 group-data-[canvas=dark]:text-neutral-100">
      <div className="mb-2 grid items-end gap-5" style={{ gridTemplateColumns: tpl }}>
        <div />
        {cols.map((c) => (
          <div key={c.id} className="font-mono text-[10px] font-semibold tracking-wider text-neutral-500 uppercase group-data-[canvas=dark]:text-neutral-400">
            {c.label}
            {c.sub && <small className="mt-0.5 block font-normal tracking-normal text-neutral-400 normal-case">{c.sub}</small>}
          </div>
        ))}
      </div>
      {rows.map((r) => (
        <div key={r.id} className="mb-7 grid items-start gap-5" style={{ gridTemplateColumns: tpl }}>
          <div className="sticky left-0 text-xs font-semibold">
            {r.label}
            {r.sub && <small className="block text-[10px] font-normal text-neutral-400">{r.sub}</small>}
          </div>
          {cols.map((c) => (
            <div key={c.id}>
              <div className="overflow-hidden" style={{ width: c.width, height: tileHeight, zoom: scale }}>
                {render(r.id, c.id, c.width)}
              </div>
              {caption && <div className="mt-1.5 font-mono text-[10px] text-neutral-400">{caption(r.id, c.id)}</div>}
            </div>
          ))}
        </div>
      ))}
    </div>
  )
}
