/**
 * Wireframe parts + region allowlist. Starting point for <wireframe>/src/wire.tsx.
 *
 * `RegionId` is the code form of the allowlist in layout.md §2: write a
 * data-region that isn't in the table and TypeScript fails the build.
 * Order for adding a region: edit layout.md §2 → edit RegionId and REGION_META → write code.
 *
 * The visuals are deliberately neutral. Brand visuals belong to design.md; with no
 * brand visuals here to copy, this file can't become a stale second source of truth
 * once design.md changes.
 */
import { createContext, useContext, useRef, useState } from 'react'
import { createPortal } from 'react-dom'
import type { ReactNode, RefObject } from 'react'

// ── Region allowlist ─────────────────────────────────────────
// TODO replace with this project's regions. Convention: lowercase, hyphenated,
// dot for nesting (parent.child), at most two levels.
export type RegionId =
  // shell
  | 'app-shell'
  | 'title-row'
  | 'body'
  | 'nav'
  | 'stage'
  | 'overlay'
  // main area
  | 'main'
  | 'main.content'
  | 'main.actions'
  // other archetypes
  | 'list'
  | 'detail'

// ── Region metadata ─────────────────────────────────────────
/**
 * `label` is for humans, the id is for agents, and `desc` states
 * **what goes here / what must not**.
 *
 * Do not write "what this is" — that's visible from the screen. A wrong
 * description is more dangerous than wrong code, because the next agent
 * extends from it.
 *
 * All three forms are bound together; changing one requires changing layout.md §2.
 */
export const REGION_META: Record<RegionId, { label: string; desc: string }> = {
  'app-shell': { label: 'App shell', desc: 'TODO what it may hold; what it never renders itself' },
  'title-row': {
    label: 'Window controls',
    desc: 'TODO layout controls allowed; business information and persistent signals forbidden',
  },
  body: { label: 'Body', desc: 'TODO' },
  nav: {
    label: 'Navigation',
    desc: 'TODO whether contents are identical across archetypes; forbids current-context content',
  },
  stage: { label: 'Stage', desc: 'TODO' },
  overlay: {
    label: 'Overlay',
    desc: 'TODO what it covers, whether it can stack, what qualifies for promotion into it',
  },
  main: { label: 'Main card', desc: 'TODO' },
  'main.content': { label: 'Main content', desc: 'TODO which content classes belong; which never do' },
  'main.actions': { label: 'Action area', desc: 'TODO' },
  list: { label: 'List column', desc: 'TODO mutating data or a fixed directory' },
  detail: { label: 'Detail area', desc: 'TODO' },
}

// ── Annotation toggle ───────────────────────────────────────
const LabelsCtx = createContext(false)
export const LabelsProvider = LabelsCtx.Provider
export const useLabels = () => useContext(LabelsCtx)

const TIP_W = 300

/**
 * Region badge. The tooltip is portalled to document.body with fixed positioning:
 * ancestors' overflow-hidden can't clip it, and it doesn't compete in the
 * prototype's stacking contexts — z-index alone can't fix this, because
 * clipping ignores z-index.
 *
 * Flip direction and horizontal clamping are computed from real viewport space,
 * so there's no hand-maintained list of "regions that open upward".
 */
function RegionLabel({ id, text, desc }: { id: RegionId; text: string; desc: string }) {
  const ref = useRef<HTMLSpanElement>(null)
  const [tip, setTip] = useState<{ left: number; top: number; up: boolean } | null>(null)

  const show = () => {
    const el = ref.current
    if (!el) return
    const r = el.getBoundingClientRect()
    const up = r.bottom + 8 + 120 > window.innerHeight
    setTip({
      left: Math.min(Math.max(8, r.left), Math.max(8, window.innerWidth - TIP_W - 8)),
      top: up ? r.top - 4 : r.bottom + 4,
      up,
    })
  }

  return (
    <span
      ref={ref}
      onMouseEnter={show}
      onMouseLeave={() => setTip(null)}
      className="absolute -top-px left-0 z-10 cursor-help rounded-br bg-sky-600/85 px-1 text-[10px] leading-[15px] font-medium whitespace-nowrap text-white hover:bg-sky-700"
    >
      {text}
      {tip &&
        createPortal(
          <div
            style={{
              position: 'fixed',
              left: tip.left,
              top: tip.top,
              width: TIP_W,
              transform: tip.up ? 'translateY(-100%)' : undefined,
              zIndex: 9999,
            }}
            className="pointer-events-none rounded-lg border border-neutral-700 bg-neutral-900 p-2.5 shadow-xl"
          >
            <p className="font-mono text-[10px] break-all text-sky-300">data-region="{id}"</p>
            {/* whitespace-normal is required: nowrap on the badge would inherit and overflow */}
            <p className="mt-1 text-[11px] leading-relaxed font-normal break-words whitespace-normal text-neutral-200">
              {desc}
            </p>
          </div>,
          document.body,
        )}
    </span>
  )
}

/** Structural container. In annotation mode, outlines itself and floats its label. */
export function Region({
  id,
  children,
  className = '',
  label,
  elRef,
}: {
  id: RegionId
  children?: ReactNode
  className?: string
  /** Overrides the badge label (e.g. a region's collapsed form) */
  label?: string
  elRef?: RefObject<HTMLDivElement | null>
}) {
  const on = useLabels()
  const meta = REGION_META[id]
  return (
    <div
      ref={elRef}
      data-region={id}
      className={`${className} ${on ? 'relative outline-1 outline-dashed outline-sky-500/50' : ''}`}
    >
      {on && <RegionLabel id={id} text={label ?? meta.label} desc={meta.desc} />}
      {children}
    </div>
  )
}

// ── Neutral wireframe parts ─────────────────────────────────
/** Status label. Expresses only "a status label goes here"; color semantics live in design.md. */
export function Badge({ children }: { children: ReactNode }) {
  return (
    <span className="shrink-0 rounded border border-neutral-400 px-1 text-[10px] leading-[14px] font-semibold text-neutral-600">
      {children}
    </span>
  )
}

/** Pill: tabs, filter chips, count badges. `on` marks the selected state. */
export function Pill({
  children,
  on = false,
  className = '',
}: {
  children: ReactNode
  on?: boolean
  className?: string
}) {
  return (
    <span
      className={`inline-flex shrink-0 items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs whitespace-nowrap ${
        on
          ? 'border-neutral-800 bg-neutral-800 font-medium text-white'
          : 'border-neutral-300 bg-white text-neutral-600'
      } ${className}`}
    >
      {children}
    </span>
  )
}

/** Button. `weight` maps to design.md's button hierarchy; the wireframe only varies grey depth. */
export function Btn({
  children,
  weight = 'secondary',
  className = '',
}: {
  children: ReactNode
  weight?: 'primary' | 'secondary' | 'outline' | 'ghost'
  className?: string
}) {
  const style = {
    primary: 'bg-neutral-800 text-white border-neutral-800 font-medium',
    secondary: 'bg-neutral-100 text-neutral-700 border-neutral-200',
    outline: 'bg-white text-neutral-700 border-neutral-400',
    ghost: 'bg-transparent text-neutral-500 border-transparent',
  }[weight]
  return (
    <button className={`rounded-lg border px-3 py-1.5 text-xs ${style} ${className}`}>
      {children}
    </button>
  )
}

/** Content block: white face + hairline. */
export function Card({ children, className = '' }: { children: ReactNode; className?: string }) {
  return (
    <div className={`rounded-lg border border-neutral-300 bg-white ${className}`}>{children}</div>
  )
}

/** Avatar / icon placeholder. The wireframe doesn't draw graphics, it reserves space. */
export function Tile({ size = 28, round = false }: { size?: number; round?: boolean }) {
  return (
    <span
      className={`shrink-0 bg-neutral-200 ${round ? 'rounded-full' : 'rounded-md'}`}
      style={{ width: size, height: size }}
    />
  )
}

/** Nav row / list row */
export function NavRow({
  children,
  on = false,
  indent = 0,
  right,
}: {
  children: ReactNode
  on?: boolean
  indent?: number
  right?: ReactNode
}) {
  return (
    <div
      className={`flex items-center gap-2 rounded-lg py-1.5 pr-2 text-sm ${
        on ? 'bg-neutral-200/80 font-medium text-neutral-900' : 'text-neutral-600'
      }`}
      style={{ paddingLeft: 10 + indent }}
    >
      <span className="flex-1 truncate">{children}</span>
      {right}
    </div>
  )
}

/** Group heading */
export function GroupLabel({ children }: { children: ReactNode }) {
  return (
    <div className="px-2.5 pt-4 pb-1 text-[11px] font-medium tracking-wide text-neutral-400">
      {children}
    </div>
  )
}

/** Non-happy-path states: one centred line plus one action. Placement rules in layout.md §8. */
export function StateBlock({
  kind,
  text,
  action,
}: {
  kind: 'empty' | 'loading' | 'partial-failure' | 'region-failure'
  text: string
  action?: string
}) {
  return (
    <div className="flex h-full flex-col items-center justify-center gap-2 p-6 text-center">
      <span className="rounded border border-neutral-300 px-1.5 py-0.5 font-mono text-[10px] text-neutral-500">
        {kind}
      </span>
      <p className="max-w-[280px] text-xs text-neutral-500">{text}</p>
      {action && <Btn weight="outline">{action}</Btn>}
    </div>
  )
}
